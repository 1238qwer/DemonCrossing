    research: build
    side: 0
    rewardGold: 500
    rewardGems: 0
    ko: "\uBE48 \uCE78\uC5D0 \uC2DD\uB2F9\uC744 \uC9C0\uC73C\uC138\uC694.\n\uC6A9\uC0AC
