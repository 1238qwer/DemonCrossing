    en: 'Hold (right-click) a building and upgrade it to Lv.2.

      Higher-level
      Diners sell pricier dishes.'
  - enabled: 1
    kind: 0
    building: 2
    amount: 1
    research: build
    side: 0
    rewardGold: 500
    rewardGems: 0
    ko: "\uAE30\uB150\uD488\uC810\uC744 \uC9C0\uC73C\uC138\uC694.\n\uC74C\uC2DD\uACFC
