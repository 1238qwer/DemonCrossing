    en: 'Build the Arena.

      Heroes spar with your monsters and pay for it.'
  - enabled: 1
    kind: 12
    building: 0
    amount: 1
    research: build
    side: 0
    rewardGold: 1500
    rewardGems: 0
    ko: "\uD22C\uAE30\uC7A5\uC744 \uAE38\uAC8C \uB20C\uB7EC \uCD9C\uC804 \uAD34\uBB3C\uC744
