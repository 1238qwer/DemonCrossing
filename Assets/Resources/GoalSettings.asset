  - enabled: 1
    kind: 2
    building: 0
    amount: 1
    research: storage
    side: 0
    rewardGold: 1000
    rewardGems: 0
    ko: "[\uC5F0\uAD6C > \uC6B4\uC601] \uC790\uC6D0 \uCC3D\uACE0 \uC5F0\uAD6C\uB85C
