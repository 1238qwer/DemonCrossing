  - enabled: 1
    kind: 0
    building: 4
    amount: 1
    research: build
    side: 0
    rewardGold: 500
    rewardGems: 0
    ko: "\uC9C1\uC6D0 \uC219\uC18C\uB97C \uC9C0\uC73C\uC138\uC694.\n\uC9C1\uC6D0\uC744
