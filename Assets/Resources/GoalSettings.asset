  - enabled: 1
    kind: 13
    building: 0
    amount: 3
    research: build
    side: 0
    rewardGold: 1000
    rewardGems: 0
    ko: "\uC9C1\uC6D0 \uC219\uC18C\uB97C Lv.2\uB85C \uC62C\uB9AC\uACE0 [\uC9C1\uC6D0]\uC5D0\uC11C
