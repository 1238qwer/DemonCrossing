  - enabled: 1
    kind: 2
    building: 0
    amount: 3
    research: build
    side: 0
    rewardGold: 1500
    rewardGems: 0
    ko: "\uAC74\uBB3C \uC5F0\uAD6C\uB97C 3\uB2E8\uACC4\uAE4C\uC9C0 \uC62C\uB9AC\uC138\uC694.
      (\uC9C0\uAE08 {1}\uB2E8\uACC4)\n\uD22C\uAE30\uC7A5\uC744 \uC9C0\uC744 \uC218
