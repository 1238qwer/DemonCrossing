    building: 0
    amount: 1
    research: build
    side: 0
    rewardGold: 300
    rewardGems: 0
    ko: "\uC5F0\uAD6C\uC18C\uC5D0 \uBCF4\uC11D\uC774 \uC0DD\uAE30\uBA74 \uD0ED\uD574\uC11C
