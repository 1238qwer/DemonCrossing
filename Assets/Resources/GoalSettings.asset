  - enabled: 1
    kind: 14
    building: 0
    amount: 1
    research: build
    side: 0
    rewardGold: 1500
    rewardGems: 0
    ko: "\uAC19\uC740 \uAD34\uBB3C\uC744 30\uB9C8\uB9AC \uC7A1\uC544 [\uB3C4\uAC10]\uC5D0
