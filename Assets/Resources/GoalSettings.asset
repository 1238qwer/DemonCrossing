  - enabled: 1
    kind: 11
    building: 0
    amount: 3
    research: build
    side: 0
    rewardGold: 300
    rewardGems: 0
    ko: "\uC804\uC2DC \uC6B0\uB9AC\uB97C \uD0ED\uD574 \uAD34\uBB3C\uC744 3\uB9C8\uB9AC
