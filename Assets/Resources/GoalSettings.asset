    research: build
    side: 0
    rewardGold: 500
    rewardGems: 0
    ko: "\uBE48 \uCE78\uC744 \uD0ED\uD574 \uD751\uB9C8\uBC95 \uC5F0\uAD6C\uC18C\uB97C
      \uC9C0\uC73C\uC138\uC694.\n\uC5F0\uAD6C\uC5D0 \uC4F0\uB294 \uBCF4\uC11D\uC744
      \uB9CC\uB4ED\uB2C8\uB2E4."
