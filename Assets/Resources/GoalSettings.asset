  - enabled: 1
    kind: 0
    building: 6
    amount: 1
    research: build
    side: 0
    rewardGold: 2000
    rewardGems: 0
    ko: "\uD22C\uAE30\uC7A5\uC744 \uC9C0\uC73C\uC138\uC694.\n\uC6A9\uC0AC\uAC00 \uAD34\uBB3C\uACFC
