  - enabled: 1
    kind: 20
    building: 0
    amount: 2
    research: build
    side: 0
    rewardGold: 1000
    rewardGems: 0
    ko: "\uAC74\uBB3C\uC744 \uAE38\uAC8C \uB20C\uB7EC(\uC6B0\uD074\uB9AD) Lv.2\uB85C
      \uC5C5\uADF8\uB808\uC774\uB4DC\uD558\uC138\uC694.\n\uC2DD\uB2F9\uC740 \uB808\uBCA8\uC774
