    building: 0
    amount: 1
    research: build
    side: 0
    rewardGold: 500
    rewardGems: 2
    ko: "[\uC5F0\uAD6C > \uC6B4\uC601] \uAC74\uBB3C \uC5F0\uAD6C 1\uB2E8\uACC4\uB97C
