  - enabled: 1
    kind: 4
    building: 0
    amount: 1
    research: build
    side: 1
    rewardGold: 1000
    rewardGems: 0
    ko: "\uC7A0\uAE34 \uC624\uB978\uCABD 1\uCE35\uC744 \uD0ED\uD574 \uC131\uC744
